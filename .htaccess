# Zugriff auf Datenbank & sensible Dateien blockieren
<FilesMatch "\.(sqlite|sqlite3|db)$">
    Require all denied
</FilesMatch>

<Files "install.php">
    # Nach der Einrichtung: Kommentar entfernen, um install.php zusätzlich
    # per Webserver zu sperren (siehe README).
    # Require all denied
</Files>

Options -Indexes
